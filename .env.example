# =========================================================================
#  Autonomous ML Monitoring & Auto-Recovery Agent — shared configuration
#  Copy to `.env`, fill in secrets, and NEVER commit the real `.env`
#  (the repo `.gitignore` already excludes it).
#
#  Read by control-plane/agent_core/config.py and Django config/settings.py.
#  See docs/deployment_and_devops.md §4 and docs/api_contracts.md §Conventions.
# =========================================================================

# ---- Ports (host-side publish; container-internal ports are fixed) -------
MODEL_A_PORT=8001
MODEL_B_PORT=8002
BACKEND_PORT=8000
JENKINS_PORT=8080

# ---- Service base URLs ----------------------------------------------------
# DOCKER (compose) uses in-cluster service names, as below.
# LOCAL venv dev (docs §8): swap each to http://localhost:<port>.
MODEL_A_URL=http://model_a:8001
MODEL_B_URL=http://model_b:8002
BACKEND_URL=http://backend:8000
JENKINS_URL=http://jenkins:8080

# ---- Django control-plane auth (api_contracts.md §B) ---------------------
DJANGO_API_TOKEN=changeme_django_drf_token            # SECRET

# ---- Jenkins remote-trigger credentials (docs §6) ------------------------
JENKINS_USER=automation
JENKINS_API_TOKEN=changeme_generate_in_jenkins_ui     # SECRET
JENKINS_JOB_DEPLOY=deploy_model
JENKINS_JOB_SWITCH=switch_active_model
JENKINS_JOB_ROLLBACK=rollback_model

# ---- ACT executor strategy ------------------------------------------------
# "direct" = Phase 2 MVP (flip active model via a direct API/in-memory call);
# "jenkins" = Phase 5 (recovery runs through Jenkins jobs). Same interface.
AGENT_EXECUTOR_TYPE=direct

# ---- Agent loop tuning (agent_core/config.py) ----------------------------
AGENT_POLL_INTERVAL_SECONDS=30        # one Observe→...→Verify cycle cadence
AGENT_HTTP_TIMEOUT_SECONDS=5          # per-request read timeout to models/backend
AGENT_HTTP_CONNECT_TIMEOUT_SECONDS=2  # connect timeout
AGENT_VERIFY_RETRIES=3                # post-action health re-checks
AGENT_VERIFY_BACKOFF_SECONDS=10       # wait between verify re-checks

# ---- Anti-flap controls (failure_scenarios.md §1.3) ----------------------
AGENT_CONFIRM_N=2                     # consecutive non-LOW cycles before acting
AGENT_COOLDOWN_CYCLES=3               # cycles to wait after a switch/rollback
AGENT_EWMA_ALPHA=0.3                  # smoothing on noisy metrics
AGENT_MAX_RECOVERY_ATTEMPTS=1         # attempts per incident before escalation

# ---- Detection thresholds (HIGH-band edges; failure_scenarios.md §1.3) ---
ERROR_RATE_THRESHOLD=0.10             # > 10% error rate => HIGH
LATENCY_P95_THRESHOLD_MS=800          # > 800ms p95 latency => HIGH
CONSECUTIVE_FAILURES_TO_SWITCH=2      # >= 2 failed /health polls => HIGH
CONFIDENCE_FLOOR=0.55                 # mean confidence < 0.55 => HIGH
INVALID_RATIO_THRESHOLD=0.10          # invalid-output ratio > 10% => HIGH
MISSING_RATIO_THRESHOLD=0.20          # missing-value ratio > 20% => HIGH
DRIFT_PSI_THRESHOLD=0.30              # PSI > 0.3 => HIGH
DRIFT_KS_P_THRESHOLD=0.001            # KS p-value < 0.001 => HIGH
ACCURACY_FLOOR=0.80                   # accuracy < 0.80 => HIGH (concept drift)
CONFIDENCE_NOTABLE_FLOOR=0.78         # mean confidence <= 0.78 => notable (LOW)
CONFIDENCE_MED_FLOOR=0.70             # mean confidence <  0.70 => MEDIUM

# ---- Confidence-based action thresholds (Phase 8 bonus; OFF by default) ---
# Tracks the SHARE of predictions in the "uncertain" zone — a leading signal the
# mean confidence hides. Enable to add a `low_confidence_ratio` detection channel.
CONFIDENCE_GATING_ENABLED=false       # master flag for the bonus
LOW_CONFIDENCE_CUTOFF=0.60            # a single prediction < this is "uncertain"
LOW_CONFIDENCE_RATIO_MED=0.20         # uncertain share >= 20% => MEDIUM
LOW_CONFIDENCE_RATIO_HIGH=0.40        # uncertain share >= 40% => HIGH

# ---- Django backend settings (venvc) -------------------------------------
DJANGO_SECRET_KEY=change_me_to_a_long_random_value     # SECRET (required when DEBUG=0)
DJANGO_DEBUG=0                         # secure default; set 1 for local dev only
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
# Security (secure-by-default). The API requires a token; mint one with
# `manage.py seed_demo` and put it in DJANGO_API_TOKEN above.
DJANGO_REQUIRE_AUTH=1                  # set 0 for an open throwaway local demo
DJANGO_EXPOSE_INTERNAL=1              # set 0 to hide endpoint_url/port + raw metric blobs
DJANGO_SSL_REDIRECT=0                  # set 1 to 301 HTTP->HTTPS behind TLS
DJANGO_THROTTLE_ANON=60/min           # unauthenticated request rate cap
DJANGO_THROTTLE_USER=2000/min         # authenticated (agent) request rate cap
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=/app/data/db.sqlite3
# Postgres alternative:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=mlmon
# DJANGO_DB_USER=mlmon
# DJANGO_DB_PASSWORD=change_me        # SECRET
# DJANGO_DB_HOST=db
# DJANGO_DB_PORT=5432
